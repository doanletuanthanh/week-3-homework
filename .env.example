# Supabase project URL (Project Settings > API). Safe to expose to the browser.
NEXT_PUBLIC_SUPABASE_URL=
# Supabase publishable key (sb_publishable_...). Safe to expose; RLS leaves it with no table access.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# App connection: Supabase transaction pooler (port 6543). Server only.
DATABASE_URL=
# Migrations, seed and CLI: Supabase session pooler or direct connection (port 5432). Server only.
DATABASE_URL_DIRECT=

# Comma-separated Google emails with admin access. Must not overlap with DEMO_ACCOUNT_EMAILS.
ADMIN_EMAILS=
# CLI only: who is running `pnpm il`. Must be one of ADMIN_EMAILS. Recorded when the CLI changes
# config or opens a learner's session (`il config set`, `il trace`).
OPERATOR_EMAIL=
# Comma-separated Google emails of demo accounts. Must not overlap with ADMIN_EMAILS.
DEMO_ACCOUNT_EMAILS=

# Secret that keys the anonymous usage counters kept after an account is deleted, so deleting
# and signing in again resets no limit. Server only, at least 32 characters, the same in every
# environment that shares a database. Generate once: `openssl rand -hex 32`. Changing it later
# makes the counters already kept unreachable.
QUOTA_HASH_SECRET=

# One variable per model call role: provider:model:effort (provider google|openai, effort minimal|low|medium|high).
# The model must have a price in src/llm/pricing.ts; confirm the ID and price in the vendor console first.
# Each role's model is the cheapest one that passed its judgement set three runs out of three
# (plans/reports/model-tiering-261014-2250-judgement-sets.md); a role without a set stays on Flash.
# Call 1: analyses each learner question and judges the previous persona reply.
LLM_ANALYSIS=google:gemini-3.8-flash:low
# Call 2: writes the persona reply.
LLM_PERSONA=google:gemini-3.8-flash:low
# Turn judge: judges a persona reply that no later Call 1 sees (replay turns, eval episodes).
# Flash-Lite: passed turn-verdict 3/3.
LLM_REPLAY_JUDGE=google:gemini-3.5-flash-lite:low
# Reveal, three calls in a row after a session ends.
# End judge: judges the last persona reply and matches the frozen notes against the items.
# Flash-Lite: passed canvas-judge 3/3, where 3.8 Flash failed it 3/3.
LLM_END_JUDGE=google:gemini-3.5-flash-lite:low
# Feedback generator: writes the comments of "Mang về".
LLM_FEEDBACK=google:gemini-3.8-flash:low
# Verifier: checks every claim before it is shown. Flash-Lite: passed leading-novelty 3/3.
LLM_VERIFIER=google:gemini-3.5-flash-lite:low
# Custom topics ("Tạo chủ đề của bạn"). Required: the app does not start without them.
# Moderation and focus classification: one call inside the submit request.
# Flash: Flash-Lite let a real-person topic through; 3.8 Flash passed the moderation set 3/3.
LLM_MODERATION=google:gemini-3.8-flash:low
# Scenario generator: writes one persona for the learner's topic.
LLM_SCENARIO_GENERATOR=google:gemini-3.8-flash:medium
# Output safety check of a generated scenario. Flash: Flash-Lite let 2 of 9 violations through.
LLM_SAFETY=google:gemini-3.8-flash:low
# Operator CLI only (`pnpm il eval`, `check-strings`, `judgement-eval`). The app does not need them.
# Simulated learner of an evaluation episode.
LLM_EVAL_INTERVIEWER=google:gemini-3.5-flash-lite:low
# Leak judge: reads a finished episode against the whole scenario. Flash: a missed leak is the costliest error.
LLM_EVAL_LEAK_JUDGE=google:gemini-3.8-flash:low
# Fixed-string check (FR-36): looks for claims about real users.
LLM_STRING_CHECK=google:gemini-3.5-flash-lite:low
# Gemini API key. Required when a role uses provider "google".
GOOGLE_API_KEY=
# OpenAI API key. Required when a role uses provider "openai".
OPENAI_API_KEY=
# Optional second keys used by the operator CLI and by scenario generation, so their load does not share a rate limit
# with live turns.
GOOGLE_API_KEY_BATCH=
OPENAI_API_KEY_BATCH=

# LangSmith tracing: "true" sends full prompts and replies of every model call.
LANGSMITH_TRACING=true
# LangSmith API key. Required when LANGSMITH_TRACING=true.
LANGSMITH_API_KEY=
# LangSmith project that receives the traces.
LANGSMITH_PROJECT=interviewlab
