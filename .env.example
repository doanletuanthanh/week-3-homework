# Supabase project URL (Project Settings > API). Safe to expose to the browser.
NEXT_PUBLIC_SUPABASE_URL=
# Supabase publishable key (sb_publishable_...). Safe to expose; RLS leaves it with no table access.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# App connection: Supabase transaction pooler (port 6543). Server only.
DATABASE_URL=
# Migrations, seed and CLI: Supabase session pooler or direct connection (port 5432). Server only.
DATABASE_URL_DIRECT=

# Comma-separated Google emails with admin access. Must not overlap with DEMO_ACCOUNT_EMAILS.
ADMIN_EMAILS=
# CLI only: who is running `pnpm il`. Must be one of ADMIN_EMAILS. Recorded when the CLI changes
# config or opens a learner's session (`il config set`, `il trace`).
OPERATOR_EMAIL=
# Comma-separated Google emails of demo accounts. Must not overlap with ADMIN_EMAILS.
DEMO_ACCOUNT_EMAILS=

# Secret that keys the anonymous usage counters kept after an account is deleted, so deleting
# and signing in again resets no limit. Server only, at least 32 characters, the same in every
# environment that shares a database. Generate once: `openssl rand -hex 32`. Changing it later
# makes the counters already kept unreachable.
QUOTA_HASH_SECRET=

# One variable per model call role: provider:model:effort (provider google|openai, effort none|minimal|low|medium|high;
# OpenAI gpt-6 models take none, not minimal, and gpt-6.1-sol starts at low).
# A comma-separated chain is tried in order: the first spec answers every call, and the next one is
# called only when the one before it has failed for good (retries spent, a bad key, credit used up).
# A streamed persona reply switches only before its first word. Every model of a chain needs a price in
# src/llm/pricing.ts and its provider's key; confirm the ID and price in the vendor console first.
# OpenAI answers; Google is the fallback. gpt-6.1-terra stands in for Gemini Flash, gpt-6-luna for
# Flash-Lite; a role runs on gpt-6-luna only if Luna passed its judgement set three runs out of three
# (plans/reports/model-tiering-261030-openai.md). The Google fallback is the Gemini model that passed the same set.
# Call 1: analyses each learner question and judges the previous persona reply.
# Terra: Luna missed the label-classifier agreement gate 3/3 (83% against 85%); Terra passed all three ANALYSIS sets.
LLM_ANALYSIS=openai:gpt-6.1-terra:low,google:gemini-3.8-flash:low
# Call 2: writes the persona reply.
LLM_PERSONA=openai:gpt-6.1-terra:none,google:gemini-3.8-flash:low
# Turn judge: judges a persona reply that no later Call 1 sees (replay turns, eval episodes).
# Luna: passed turn-verdict 3/3.
LLM_REPLAY_JUDGE=openai:gpt-6-luna:low,google:gemini-3.5-flash-lite:low
# Reveal, three calls in a row after a session ends.
# End judge: judges the last persona reply and matches the frozen notes against the items.
# Luna: passed canvas-judge 3/3.
LLM_END_JUDGE=openai:gpt-6-luna:low,google:gemini-3.5-flash-lite:low
# Feedback generator: writes the comments of "Mang về".
LLM_FEEDBACK=openai:gpt-6.1-terra:low,google:gemini-3.8-flash:low
# Verifier: checks every claim before it is shown. Luna: passed leading-novelty 3/3.
LLM_VERIFIER=openai:gpt-6-luna:low,google:gemini-3.5-flash-lite:low
# Custom topics ("Tạo chủ đề của bạn"). Required: the app does not start without them.
# Moderation and focus classification: one call inside the submit request.
# Luna: passed the moderation set 3/3. Fallback 3.8 Flash: Flash-Lite let a real-person topic through.
LLM_MODERATION=openai:gpt-6-luna:low,google:gemini-3.8-flash:low
# Scenario generator: writes one persona for the learner's topic. Rare and quality-bound: the strongest model.
LLM_SCENARIO_GENERATOR=openai:gpt-6.1-sol:medium,google:gemini-3.8-flash:medium
# Output safety check of a generated scenario. Luna: passed output-safety 3/3. Fallback 3.8 Flash:
# Flash-Lite let 2 of 9 violations through.
LLM_SAFETY=openai:gpt-6-luna:low,google:gemini-3.8-flash:low
# Operator CLI only (`pnpm il eval`, `check-strings`, `judgement-eval`). The app does not need them.
# Leak judge: reads the lean eval's probe replies against the whole scenario. A missed leak is the costliest error.
LLM_EVAL_LEAK_JUDGE=openai:gpt-6.1-terra:low,google:gemini-3.8-flash:low
# Fixed-string check (FR-36): looks for claims about real users.
LLM_STRING_CHECK=openai:gpt-6-luna:low
# Persona QA agent (`il eval --profile lean`): plans the probes and reflects on their results. It reads
# the whole scenario, locked items included, so it never takes part in a learner's session.
LLM_QA_PLANNER=openai:gpt-6.1-terra:low,google:gemini-3.8-flash:low
# Gemini API key. Required when any role (fallbacks included) uses provider "google".
GOOGLE_API_KEY=
# OpenAI API key. Required when any role (fallbacks included) uses provider "openai".
OPENAI_API_KEY=
# Optional second keys used by the operator CLI and by scenario generation, so their load does not share a rate limit
# with live turns.
GOOGLE_API_KEY_BATCH=
OPENAI_API_KEY_BATCH=

# LangSmith tracing: "true" sends full prompts and replies of every model call.
LANGSMITH_TRACING=true
# LangSmith API key. Required when LANGSMITH_TRACING=true.
LANGSMITH_API_KEY=
# LangSmith project that receives the traces.
LANGSMITH_PROJECT=interviewlab
