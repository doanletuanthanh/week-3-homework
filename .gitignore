# Personal / machine-local config (regenerated by installers, holds per-user answers)
_bmad/config.user.toml
_bmad/custom/*.user.toml
.claude/settings.local.json
.claude/worktrees/

# Secrets
.env
.env.*
!.env.example
*.pem
*.key

# Python / tooling caches
__pycache__/
*.py[cod]
.pytest_cache/
.venv/
.uv-cache/

# OS / editor noise
.DS_Store
Thumbs.db
desktop.ini
.vscode/
.idea/
*.swp
*.log

# Node / Next.js
node_modules/
/.next/
/out/
/coverage
.vercel
*.tsbuildinfo
next-env.d.ts

# Playwright
/test-results/
/playwright-report/
/tests/e2e/.auth/

# Agent working memory (machine-local)
.claude/agent-memory/
